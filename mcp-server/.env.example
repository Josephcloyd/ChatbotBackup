# MCP Server
MCP_PORT=3001

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_PREDICT=8192
OLLAMA_TIMEOUT_MS=600000

# Optional Supabase storage/history.
# Leave these blank for local-only workbook generation.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WORKBOOK_BUCKET=production-workbooks
SUPABASE_SIGNED_URL_EXPIRES_IN_SECONDS=3600

# WhatsApp Bot.
# For the first run, keep WHATSAPP_ALLOWED_GROUP_ID blank and set
# WHATSAPP_LOG_FULL_GROUP_ID=1. After the bot prints the full group ID,
# paste it into WHATSAPP_ALLOWED_GROUP_ID and set WHATSAPP_LOG_FULL_GROUP_ID=0.
# Leave blank to reuse an existing local session when possible.
# Only change this before the first QR scan for a machine.
WHATSAPP_CLIENT_ID=
WHATSAPP_ALLOWED_GROUP_ID=
WHATSAPP_ALLOWED_GROUP_NAME=test bot
WHATSAPP_BOT_MENTION_NAME=wil alt
WHATSAPP_BOT_MENTION_ID=
WHATSAPP_LOG_FULL_GROUP_ID=1
# Optional. Set this if Chrome is installed somewhere unusual.
WHATSAPP_CHROME_PATH=
# Visible Chrome is more reliable while linking on a new machine.
WHATSAPP_HEADLESS=0
WHATSAPP_AUTH_TIMEOUT_MS=120000
WHATSAPP_USER_AGENT=
