{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "Standalone MCP server for production planning",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/server.ts",
    "start": "node --env-file=.env --import tsx src/server.ts",
    "smoke": "tsx scripts/smokeTest.ts",
    "demo:dynamic": "tsx scripts/generateDynamicDemo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "whatsapp:dev": "node --env-file=.env --import tsx src/whatsappBot.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.110.0",
    "@types/nodemailer": "^8.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "nodemailer": "^9.0.3",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3"
  }
}
